<mxfile host="app.diagrams.net" modified="2026-11-10T17:00:00" agent="WorkBuddy" version="24.0.0" type="device"><diagram id="zhaoxi-huxing-flow-v2" name="朝夕护行处置流程"><mxGraphModel dx="1600" dy="2300" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="朝夕护行 · 跌倒检测与业务处置流程（按项目实际执行顺序）" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1500" height="48" as="geometry"/></mxCell><mxCell id="subtitle" value="主干：配置与档案 → 视频接入 → 服务与权重判断 → 姿态跟踪与时序判定 → 事件输出 →（预留）告警生成 → 分级处置 → 家属推送 → 社区联动审核 → 干预 / 日程 / 空间整改 → 档案回写" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1500" height="34" as="geometry"/></mxCell><mxCell id="g1" value="一、配置与基础数据（流程起点）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1500" height="180" as="geometry"/></mxCell><mxCell id="A1" value="A1　模型参数配置&lt;br&gt;业务端：检测 / 评估 / 告警 / 设备四类参数，保存、恢复默认、版本回滚；&lt;br&gt;算法端：模型目录与权重、置信度阈值 0.40、冷却帧数 90、推理设备与线程数。&lt;br&gt;两套配置分别生效，互不自动同步。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="690" height="110" as="geometry"/></mxCell><mxCell id="A2" value="A2　档案与台账&lt;br&gt;老人档案与设备绑定、设备类型与在线状态、居家空间档案（适老化配置 / 风险因素 / 安全评级）、既往跌倒记录、步态记录、健康备注。&lt;br&gt;对照数据，不是检测输入源。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="170" width="720" height="110" as="geometry"/></mxCell><mxCell id="g2" value="二、视频接入与推理服务（单路视频，替换原三模态证据融合）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1500" height="300" as="geometry"/></mxCell><mxCell id="B1" value="B1　视频输入&lt;br&gt;上传并校验扩展名 / 按服务器本地路径检测。&lt;br&gt;不接入惯性、门磁、红外、雷达数据。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="270" height="95" as="geometry"/></mxCell><mxCell id="B2" value="B2　调用方式？&lt;br&gt;同步 / 异步" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF4D6;strokeColor=#D99A17;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="370" y="375" width="190" height="85" as="geometry"/></mxCell><mxCell id="B3" value="B3　模型可用？&lt;br&gt;权重与 LSTM 检查点" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF4D6;strokeColor=#D99A17;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="590" y="375" width="190" height="85" as="geometry"/></mxCell><mxCell id="B4" value="B4　推理链&lt;br&gt;17 关键点 → 跨帧跟踪同一人 → 关键点特征 → LSTM 三分类；&lt;br&gt;阈值 0.40 与冷却帧数 90 抑制重复触发，推理加锁串行。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="810" y="365" width="330" height="110" as="geometry"/></mxCell><mxCell id="B5" value="B5　结果输出&lt;br&gt;结构化事件：视频元数据、人物编号、起止帧、时间戳、置信度、跌倒总数、跟踪人数。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="365" width="340" height="110" as="geometry"/></mxCell><mxCell id="B2a" value="异步任务&lt;br&gt;返回任务编号 → 待处理 / 运行中 / 完成 / 失败轮询至终态" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="350" y="490" width="230" height="95" as="geometry"/></mxCell><mxCell id="B3a" value="降级模式（流程终止）&lt;br&gt;服务仍可启动、健康检查与模型状态可查；&lt;br&gt;推理返回明确的模型缺失错误，不产生事件与告警。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FDE8E8;strokeColor=#D14343;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="600" y="490" width="260" height="95" as="geometry"/></mxCell><mxCell id="B4a" value="权重选择&lt;br&gt;改进版优先；缺失自动回退原版，&lt;br&gt;健康检查可查生效版本与是否回退。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="490" width="260" height="95" as="geometry"/></mxCell><mxCell id="B5a" value="标注视频分支&lt;br&gt;开关开启 → 生成并下载；关闭 → 仅返回事件；&lt;br&gt;同步调用结束清理上传原视频、保留标注视频。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="1170" y="490" width="340" height="95" as="geometry"/></mxCell><mxCell id="g3" value="三、检测与业务的衔接（预留 / 可选）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1500" height="250" as="geometry"/></mxCell><mxCell id="C1" value="C1　是否对接业务层？&lt;br&gt;当前为预留能力" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF4D6;strokeColor=#D99A17;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="690" width="270" height="110" as="geometry"/></mxCell><mxCell id="C2" value="C2　告警入库&lt;br&gt;类型：跌倒 / 异常步态 / 设备离线 / 紧急；级别：紧急 / 重要 / 普通；&lt;br&gt;老人、位置、紧急联系人、建议措施；状态待处理、未读。&lt;br&gt;分级在告警生成时发生。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="400" y="690" width="420" height="110" as="geometry"/></mxCell><mxCell id="C3" value="C3　设备离线分支&lt;br&gt;设备离线 / 故障 / 离线超时产生设备离线告警，汇入同一处置链。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="690" width="330" height="110" as="geometry"/></mxCell><mxCell id="C0" value="未对接（当前默认）&lt;br&gt;结果仅用于前端展示与人工查看；业务告警由管理端录入或其他来源产生。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="810" width="270" height="65" as="geometry"/></mxCell><mxCell id="Cnote" value="连接关系说明：算法服务与后端无强制依赖，前端未直连检测服务，事件写回告警为文档标注的预留能力；虚线表示可选、预留或非自动流转的关联。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#CBD5E1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="810" width="810" height="65" as="geometry"/></mxCell><mxCell id="g4" value="四、告警处置（人工动作，替换原图按置信度分流）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="1500" height="290" as="geometry"/></mxCell><mxCell id="D1" value="D1　实时告警列表&lt;br&gt;按类型 / 级别 / 状态 / 时间筛选，5 / 10 / 30 秒刷新；&lt;br&gt;未读、新告警、待处理、处理中、今日新增统计。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="960" width="330" height="85" as="geometry"/></mxCell><mxCell id="D2" value="D2　人工动作？" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF4D6;strokeColor=#D99A17;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="955" width="210" height="100" as="geometry"/></mxCell><mxCell id="D3" value="D3　站内通知&lt;br&gt;按用户生成告警 / 系统 / 提醒通知，未读计数、单条与全部已读；与家属推送是两条独立通道。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="1150" y="960" width="360" height="85" as="geometry"/></mxCell><mxCell id="D2a" value="标记已读（单条 / 批量）&lt;br&gt;仅置已读，状态不变" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="1080" width="330" height="85" as="geometry"/></mxCell><mxCell id="D2b" value="处理（单条 / 批量）&lt;br&gt;直接置已解决，写处理人、备注、时间并置已读" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#2E7D32;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="430" y="1080" width="330" height="85" as="geometry"/></mxCell><mxCell id="D2c" value="忽略（单条 / 批量）&lt;br&gt;置已忽略并置已读" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="1080" width="330" height="85" as="geometry"/></mxCell><mxCell id="D2d" value="未操作&lt;br&gt;保持待处理；「处理中」仅为台账状态，无自动流转动作" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="1150" y="1080" width="330" height="85" as="geometry"/></mxCell><mxCell id="g5" value="五、家属推送" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="1500" height="290" as="geometry"/></mxCell><mxCell id="E1" value="E1　偏好过滤&lt;br&gt;渠道开关（短信 / 微信 / APP / 推送）、级别与渠道约束（普通仅 APP）、&lt;br&gt;场景开关与场景渠道、延迟分钟数、静音时段、模板与接收人。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="1270" width="400" height="100" as="geometry"/></mxCell><mxCell id="E2" value="E2　执行与日志&lt;br&gt;写渠道、场景、简要 / 完整内容、状态、耗时、响应、家属电话。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="510" y="1270" width="310" height="100" as="geometry"/></mxCell><mxCell id="E3" value="E3　结果？" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF4D6;strokeColor=#D99A17;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="860" y="1275" width="180" height="90" as="geometry"/></mxCell><mxCell id="E1a" value="场景关闭 → 不推送" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="1390" width="250" height="80" as="geometry"/></mxCell><mxCell id="E1b" value="命中静音 / 延迟 → 延迟推送" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="340" y="1390" width="250" height="80" as="geometry"/></mxCell><mxCell id="E3a" value="成功 → 结束" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#2E7D32;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="860" y="1390" width="250" height="80" as="geometry"/></mxCell><mxCell id="E3b" value="失败 / 重试中 → 单条或批量重试，次数 +1 并记重试历史；仍失败保留失败日志" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FDE8E8;strokeColor=#D14343;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="1130" y="1390" width="380" height="80" as="geometry"/></mxCell><mxCell id="g6" value="六、社区联动审核（项目里真正的人工复核）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="1500" height="190" as="geometry"/></mxCell><mxCell id="F1" value="F1　社区处理记录&lt;br&gt;以关联告警编号建立台账；联动动作、处理人、结果、社区、附件；初始待审核。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="1580" width="420" height="100" as="geometry"/></mxCell><mxCell id="F2" value="F2　审核？" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF4D6;strokeColor=#D99A17;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="540" y="1585" width="200" height="90" as="geometry"/></mxCell><mxCell id="F3" value="通过 → 记审核意见与时间并归档" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E6F4EA;strokeColor=#2E7D32;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="1570" width="300" height="80" as="geometry"/></mxCell><mxCell id="F4" value="驳回 → 记驳回原因，退回修改后重新提交" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FDE8E8;strokeColor=#D14343;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="800" y="1660" width="300" height="55" as="geometry"/></mxCell><mxCell id="Fnote" value="替换原图「中置信或冲突事件转人工复核、结果回流标注集」：项目没有置信度自动分流，也没有标注集回流。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#CBD5E1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="1150" y="1580" width="360" height="100" as="geometry"/></mxCell><mxCell id="g7" value="七、干预、日程、空间整改与档案回写" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="1740" width="1500" height="230" as="geometry"/></mxCell><mxCell id="G1" value="G1　干预方案&lt;br&gt;创建并提交审核（草稿 → 待审核）；通过 → 批准执行，驳回 → 退回草稿；按周期与频率推进，汇总进度、执行次数、异常次数。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="70" y="1790" width="270" height="120" as="geometry"/></mxCell><mxCell id="G2" value="G2　执行记录&lt;br&gt;每次执行记正常 / 部分完成 / 跳过 / 异常状态、评分与附件，回写方案进度。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="360" y="1790" width="270" height="120" as="geometry"/></mxCell><mxCell id="G3" value="G3　康养日程&lt;br&gt;按触发原因（跌倒后复检、康复训练）生成任务，关联告警编号与设备序列号；待处理 → 处理中 → 已完成。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="650" y="1790" width="270" height="120" as="geometry"/></mxCell><mxCell id="G4" value="G4　空间巡检与整改&lt;br&gt;通过 → 结束；不通过 / 需整改 → 记问题、整改状态与期限，复查后更新安全评级与风险因素。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="940" y="1790" width="270" height="120" as="geometry"/></mxCell><mxCell id="G5" value="G5　档案回写&lt;br&gt;更新既往跌倒记录、步态记录、健康备注及跟进状态，作为下一轮风险判断依据。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E8F1FB;strokeColor=#3B7DD8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing=4;" vertex="1" parent="1"><mxGeometry x="1230" y="1790" width="280" height="120" as="geometry"/></mxCell><mxCell id="Gnote" value="G5 回写 A2 档案形成闭环；G1–G5 均为管理端以关联告警编号人工登记，不是算法自动流转。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#CBD5E1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="1920" width="1440" height="40" as="geometry"/></mxCell><mxCell id="g8" value="八、贯穿旁路（任意时点可触发，作用于上游配置 / 权重）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="1990" width="1500" height="140" as="geometry"/></mxCell><mxCell id="H1" value="H1　参数版本治理（作用于 A1）&lt;br&gt;保存 / 恢复默认 / 回滚各生成一条新版本记录（操作人、描述），不改写已产生的告警与事件。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE7F6;strokeColor=#7E57C2;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#1F2937;spacing