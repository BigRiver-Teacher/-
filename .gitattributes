* text=auto

# Windows 脚本与配置需保持 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Unix 脚本、源码统一 LF
*.sh    text eol=lf
*.py    text eol=lf
*.java  text eol=lf
*.ts    text eol=lf
*.vue   text eol=lf
*.md    text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.pt    binary
*.pth   binary
*.onnx  binary
*.mp4   binary
*.jar   binary

# 语言统计（GitHub Linguist）
*.ipynb linguist-vendored
package-lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
