# 本地开发环境变量模板
# 用法：复制为 backend/.env.local（Windows: copy .env.local.example .env.local）
#
# 应用启动时会自动读取 backend/.env.local，仅补充「当前未设置」的环境变量，
# 不会覆盖真实环境变量；JWT_SECRET 缺失时由启动引导自动生成到 backend/.jwt-secret.local。

# 数据库密码（本地演示用）
DB_PASSWORD=123456

# 可选
# DB_USERNAME=root
# DB_URL=jdbc:mysql://localhost:3306/elderly_care?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true
# JWT_SECRET=
