# ============================================================
# 朝夕护行 · 摔倒检测服务 环境变量模板
# 用法：copy .env.example .env（Windows）/ cp .env.example .env（Linux/macOS）
# .env 含本机路径，已被 .gitignore 排除，请勿提交
# ============================================================

# ---- 模型路径 ----
# 模型工程根目录：相对 algorithm/ 目录，也可写绝对路径
FALL_MODEL_DIR=models

# YOLO 姿态估计权重文件名（相对 FALL_MODEL_DIR）
# v2 改进版权重，缺失时自动回退 yolo11n-pose.pt
FALL_YOLO_MODEL=yolo11n-pose-fallen.pt

# LSTM 分类检查点（相对 FALL_MODEL_DIR）
# 默认 v2：八特征、二分类（normal / fallen）
FALL_LSTM_CHECKPOINT=models/checkpoints/v2_hard_samples_20260903/last.pth
# 回退 v1：五特征、三分类（normal / falling / fallen）
# FALL_LSTM_CHECKPOINT=models/checkpoints/best.pth

# BoT-SORT 跟踪器配置（相对 FALL_MODEL_DIR）
FALL_TRACKER_CONFIG=configs/botsort.yaml

# ---- 推理参数 ----
# cuda / cpu / 留空自动选择
FALL_DEVICE=

# 跌倒置信度阈值（0~1）
FALL_CONFIDENCE_THRESHOLD=0.40

# 告警冷却帧数
FALL_COOLDOWN_FRAMES=90

# 异步任务线程数（计算密集型，默认 1 串行）
FALL_MAX_WORKERS=1

# ---- 文件目录 ----
FALL_UPLOAD_DIR=uploads
FALL_OUTPUT_DIR=outputs

# ---- 服务启动 ----
FALL_HOST=0.0.0.0
FALL_PORT=8001
FALL_RELOAD=false
