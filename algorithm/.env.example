# ============================================================
# 朝夕护行 · 摔倒检测服务 环境变量模板（复制为 .env 使用）
# 注意：.env 含本机路径，切勿提交到公开仓库
# ============================================================

# ---- 模型路径（完整模式） ----
# 完整模型工程目录：放置于 algorithm/models/，相对 algorithm 目录
FALL_MODEL_DIR=models

# YOLO 姿态估计模型文件名（相对 FALL_MODEL_DIR，支持绝对路径）
# v2 改进版权重：model-v2-resources/weights/yolo11n-pose-fallen.pt（复制到 models/ 后可用）
# 回退 v1：改为 yolo11n-pose.pt
FALL_YOLO_MODEL=yolo11n-pose-fallen.pt

# LSTM 跌倒分类检查点（相对 FALL_MODEL_DIR）
FALL_LSTM_CHECKPOINT=models/checkpoints/best.pth

# 跟踪器配置（相对 FALL_MODEL_DIR）
FALL_TRACKER_CONFIG=configs/botsort.yaml

# ---- 推理参数 ----
# cuda / cpu / 留空自动选择
FALL_DEVICE=

# 跌倒置信度阈值（0~1）
FALL_CONFIDENCE_THRESHOLD=0.40

# 告警冷却帧数
FALL_COOLDOWN_FRAMES=90

# 异步任务线程数（计算密集型，默认 1 串行）
FALL_MAX_WORKERS=1

# ---- 文件目录 ----
FALL_UPLOAD_DIR=uploads
FALL_OUTPUT_DIR=outputs

# ---- 服务启动 ----
FALL_HOST=0.0.0.0
FALL_PORT=8001
FALL_RELOAD=false
