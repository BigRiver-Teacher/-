# ===== 依赖与构建产物 =====
node_modules/
dist/
dist-ssr/
build/
target/
out/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# ===== IDE / 系统 =====
.idea/
.vscode/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ===== 运行时数据与日志 =====
logs/
*.log
uploads/
outputs/
algorithm/uploads/
algorithm/outputs/
*.tsbuildinfo
.eslintcache

# 训练/评测证据日志需随仓库保留
!algorithm/model-v2-resources/evidence/*.log

# ===== 本地配置（含凭证，禁止提交）=====
.env
.env.local
.env.*.local
application-local.properties
*.local.properties

# ===== 大体积媒体文件（演示视频等）=====
*.mp4
*.avi
*.mov
*.mkv
*.flv
*.webm
*.m4v
# 例外：frontend/public/videos 下登记过的演示视频需要随仓库分发
!frontend/public/videos/*.mp4
!frontend/public/videos/*.webm
!frontend/public/videos/*.m4v

# ===== 模型权重（体积大，不随仓库分发）=====
# 需按 algorithm/README.md「三、权重文件」中的说明自行放置
*.pt
*.pth
*.onnx
*.engine

# ===== 本地备份 / 临时文件 =====
.backup-*/
*.bak
*.orig

# ===== 说明 =====
# 1. 权重与 .env 均不纳入版本库：clone 后请按 README 放置权重、复制 .env.example 为 .env。
# 2. 示例事件 JSON（algorithm/models/output/test_events.json）为小文件，需要随仓库保留。
