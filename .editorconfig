root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,xml}]
indent_size = 4

[*.{ts,tsx,js,jsx,vue,json,yml,yaml,css,scss,html}]
indent_size = 2

[*.py]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
