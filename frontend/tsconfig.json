{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client"]
  },
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue", "auto-imports.d.ts", "components.d.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
